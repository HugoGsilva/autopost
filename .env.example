# Copie para .env na VPS e preencha. NUNCA versione o .env.

# Endereço público (HTTPS) onde o Cast vai rodar. É a base das URLs de retorno OAuth.
APP_URL=https://cast.ia2s.com.br
BETTER_AUTH_URL=https://cast.ia2s.com.br

# Gere com: openssl rand -base64 32  (também deriva a chave que criptografa os tokens das redes)
BETTER_AUTH_SECRET=

# Senha do Postgres do docker compose
POSTGRES_PASSWORD=

# Usado só para validar as variáveis durante o build (o compose monta a URL real em runtime)
DATABASE_URL=postgresql://postgres:troque@postgres:5432/autopost

# Porta exposta no host (o proxy reverso aponta para ela)
WEB_PORT=3001

# Só este e-mail consegue criar o admin no primeiro acesso. Sem isso, quem abrir
# o endereço primeiro vira administrador.
SETUP_ADMIN_EMAIL=

# IP/CIDR do proxy (Caddy/Nginx/Traefik). Sem isso o limite de login vê só o IP do proxy.
TRUSTED_PROXIES=

# true só em ambiente de treino. Em produção deixe false.
DEMO_ENABLED=false
