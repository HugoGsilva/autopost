{
	"name": "autopost",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/node": "^26.4.1",
			"varlock": "1.23.0",
			"lucide-react": "^1.41.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.8",
			"@orpc/server": "^1.15.6",
			"@orpc/client": "^1.15.6",
			"@orpc/openapi": "^1.15.6",
			"@orpc/zod": "^1.15.6",
			"better-auth": "1.7.12",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.7",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "1.0.0-rc.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"db:push": "bun run --cwd packages/db db:push",
		"db:studio": "bun run --cwd packages/db db:studio",
		"db:generate": "bun run --cwd packages/db db:generate",
		"db:migrate": "bun run --cwd packages/db db:migrate",
		"db:start": "bun scripts/dev-db.ts",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/web && bun run auth:generate",
		"check": "biome check --write .",
		"dev:worker": "turbo run dev -F worker --",
		"test": "bun test --cwd packages/social",
		"test:e2e": "playwright test",
		"test:all": "bun run test && bun run test:e2e"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@autopost/config": "workspace:*",
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.2",
		"@playwright/test": "^1.64.1",
		"@types/node": "catalog:",
		"date-fns": "4.4.0",
		"embedded-postgres": "18.6.0-beta.19",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"overrides": {
		"@next/env": "npm:@varlock/nextjs-integration@1.2.2"
	},
	"packageManager": "bun@1.3.14"
}
