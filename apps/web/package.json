{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3001",
		"build": "tsc -b ../../packages/api && next build",
		"check-types": "next typegen && tsc -b ../../packages/api && tsc --noEmit",
		"start": "next start",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
	},
	"dependencies": {
		"@autopost/api": "workspace:*",
		"@autopost/auth": "workspace:*",
		"@autopost/db": "workspace:*",
		"@autopost/social": "workspace:*",
		"@autopost/ui": "workspace:*",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/utilities": "^3.2.2",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/tanstack-query": "^1.15.6",
		"@orpc/zod": "catalog:",
		"@swc/helpers": "^0.5.23",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.2",
		"@varlock/nextjs-integration": "1.2.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"better-auth": "catalog:",
		"date-fns": "^4.4.0",
		"lucide-react": "catalog:",
		"next": "^16.3.4",
		"next-themes": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"simple-icons": "^16.36.0",
		"sonner": "catalog:",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@autopost/config": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
		"@tanstack/react-query-devtools": "^5.104.2",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:"
	}
}
